#!/usr/bin/env bash
# Cuvée: VMs de macOS no Arch Linux, sobre o reims-ctl do projeto reims-vgpu.
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
#   cuvee doctor       verifica o host (KVM, udmabuf, GPU, sessão gráfica)
#   cuvee setup-host   corrige o que o doctor apontar (usa sudo)
#   cuvee [...]        qualquer outro comando vai para o reims-ctl

set -euo pipefail

CUVEE_VERSION="@VERSION@"
LIBDIR="${CUVEE_LIBDIR:-/usr/lib/cuvee}"
QEMU_BIN="$LIBDIR/qemu/bin/qemu-system-x86_64"
USER="${USER:-$(id -un)}"

if [[ -t 1 ]]; then
  B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'
else
  B='' G='' Y='' R='' N=''
fi
ok() { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*"; WARNINGS=$((WARNINGS + 1)); }
bad() { printf '  %s✗%s %s\n' "$R" "$N" "$*"; PROBLEMS=$((PROBLEMS + 1)); }
title() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }
die() { printf '%scuvee:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
PROBLEMS=0 WARNINGS=0

in_group() { id -nG "${1:-$USER}" | tr ' ' '\n' | grep -qx "$2"; }

# Fabricante de cada GPU, pelo ID PCI em /sys.
gpu_vendors() {
  local f
  for f in /sys/class/drm/card[0-9]*/device/vendor; do
    [[ -r $f ]] || continue
    case "$(cat "$f")" in
      0x1002) echo amd ;;
      0x8086) echo intel ;;
      0x10de) echo nvidia ;;
      *) echo other ;;
    esac
  done | sort -u
}

check_cpu() {
  title "Processador e KVM"
  if grep -qE '\b(vmx|svm)\b' /proc/cpuinfo; then
    ok "virtualização por hardware disponível"
  else
    bad "sem VT-x/AMD-V: ative a virtualização no firmware (BIOS/UEFI)"
  fi
  if [[ ! -e /dev/kvm ]]; then
    bad "/dev/kvm não existe: carregue kvm_intel ou kvm_amd (sudo modprobe kvm_intel)"
  elif [[ -r /dev/kvm && -w /dev/kvm ]]; then
    ok "/dev/kvm acessível"
  else
    bad "sem acesso a /dev/kvm: rode cuvee setup-host (adiciona você ao grupo kvm)"
  fi
  if [[ " $(gpu_vendors) " == *" nvidia "* ]] && (($(sysctl -n vm.max_map_count 2>/dev/null || echo 0) < MAX_MAP_COUNT)); then
    echo "vm.max_map_count = $MAX_MAP_COUNT" | sudo tee /etc/sysctl.d/70-cuvee.conf >/dev/null
    sudo sysctl -q -w vm.max_map_count="$MAX_MAP_COUNT"
    ok "vm.max_map_count = $MAX_MAP_COUNT (NVIDIA; /etc/sysctl.d/70-cuvee.conf)"
  fi

  if ! in_group "$USER" kvm; then
    warn "você não está no grupo kvm (necessário para VMs iniciadas por ssh)"
  fi
}

check_udmabuf() {
  title "udmabuf (memória do macOS para a GPU)"
  if [[ ! -e /dev/udmabuf ]]; then
    bad "/dev/udmabuf não existe: rode cuvee setup-host (carrega o módulo udmabuf)"
    return
  fi
  local group
  group="$(stat -c %G /dev/udmabuf)"
  if [[ -r /dev/udmabuf && -w /dev/udmabuf ]]; then
    ok "/dev/udmabuf acessível (grupo $group)"
  else
    bad "sem acesso a /dev/udmabuf (grupo $group): rode cuvee setup-host e entre de novo na sessão"
  fi
}

check_gpu() {
  title "GPU do host"
  local vendors
  vendors="$(gpu_vendors)"
  if [[ -z $vendors ]]; then
    bad "nenhuma GPU encontrada em /sys/class/drm"
    return
  fi
  local v
  for v in $vendors; do
    case "$v" in
      amd) ok "AMD: use o driver RADV (pacote vulkan-radeon)" ;;
      intel) ok "Intel: use o driver ANV (pacote vulkan-intel)" ;;
      nvidia) ok "NVIDIA: use o driver proprietário ou nvidia-open (pacote nvidia-utils)" ;;
      *) warn "GPU de fabricante desconhecido: pode não ter Vulkan" ;;
    esac
  done
  if command -v vulkaninfo >/dev/null 2>&1; then
    if vulkaninfo --summary >/dev/null 2>&1; then
      ok "Vulkan funcionando"
    else
      bad "vulkaninfo falhou: instale o driver Vulkan da sua GPU"
    fi
  else
    warn "vulkaninfo não instalado (pacote vulkan-tools): não deu para testar o Vulkan"
  fi
}

check_session() {
  title "Sessão gráfica"
  case "${XDG_SESSION_TYPE:-}" in
    wayland) ok "Wayland" ;;
    x11) ok "X11" ;;
    *)
      if [[ -n ${WAYLAND_DISPLAY:-} ]]; then ok "Wayland"
      elif [[ -n ${DISPLAY:-} ]]; then ok "X11"
      else warn "sem sessão gráfica: a VM só roda sem janela (headless)"
      fi
      ;;
  esac
}

check_iommu() {
  title "IOMMU (para passar uma GPU física para a VM)"
  if compgen -G '/sys/kernel/iommu_groups/*' >/dev/null; then
    ok "IOMMU ativo: GPU passthrough é possível"
  else
    warn "IOMMU desligado: só precisa dele para acelerar macOS 10.13 a 15 com uma GPU dedicada"
  fi
}

check_max_map_count() {
  [[ " $(gpu_vendors) " == *" nvidia "* ]] || return 0
  title "vm.max_map_count (NVIDIA)"
  local cur
  cur="$(sysctl -n vm.max_map_count 2>/dev/null || echo 0)"
  if ((cur >= MAX_MAP_COUNT)); then
    ok "vm.max_map_count = $cur"
  else
    warn "vm.max_map_count = $cur; o reims-ctl recomenda $MAX_MAP_COUNT em NVIDIA: rode cuvee setup-host"
  fi
}

check_install() {
  title "Instalação"
  if [[ -x $QEMU_BIN ]]; then ok "QEMU com reims-vgpu em $LIBDIR/qemu"
  else bad "QEMU do reims-vgpu não encontrado em $QEMU_BIN: instale o pacote reims-vgpu-git"
  fi
  if command -v reims-ctl >/dev/null 2>&1; then ok "reims-ctl instalado"
  else bad "reims-ctl não encontrado: instale o pacote reims-vgpu-git"
  fi
  if command -v reims-util >/dev/null 2>&1; then ok "reims-util instalado"
  else bad "reims-util não encontrado: instale o pacote reims-vgpu-git"
  fi
}

cmd_doctor() {
  check_cpu
  check_udmabuf
  check_gpu
  check_session
  check_iommu
  check_max_map_count
  check_install
  echo
  if ((PROBLEMS)); then
    printf '%s%d problema(s)%s e %d aviso(s).\n' "$R" "$PROBLEMS" "$N" "$WARNINGS"
  else
    printf '%sTudo certo%s (%d aviso(s)).\n' "$G" "$N" "$WARNINGS"
  fi
  if command -v reims-ctl >/dev/null 2>&1 && [[ -x $QEMU_BIN ]]; then
    title "Diagnóstico do reims-ctl"
    # Não decide o código de saída: o reims-ctl acusa "no install record" porque
    # o pacote não passou pelo scripts/install-ctl.sh; aqui quem atualiza é o pacman.
    REIMS_CTL_QEMU="${REIMS_CTL_QEMU:-$QEMU_BIN}" reims-ctl doctor 2>&1 |
      grep -v 'no install record' || true
    echo "(\"checkout\" sem registro de instalação é esperado: o Cuvée é atualizado pelo pacman)"
  fi
  ((PROBLEMS == 0))
}

cmd_setup_host() {
  [[ $EUID -ne 0 ]] || die "rode como seu usuário normal, sem sudo: o cuvee pede sudo quando precisa"
  local changed=0
  title "Preparando o host"

  if [[ ! -e /dev/udmabuf ]]; then
    sudo modprobe udmabuf && ok "módulo udmabuf carregado" && changed=1
  fi
  if [[ ! -e /usr/lib/modules-load.d/cuvee.conf && ! -e /etc/modules-load.d/cuvee.conf ]]; then
    echo udmabuf | sudo tee /etc/modules-load.d/cuvee.conf >/dev/null
    ok "udmabuf vai carregar em todo boot (/etc/modules-load.d/cuvee.conf)"
  fi
  if [[ ! -e /usr/lib/udev/rules.d/70-cuvee-udmabuf.rules && ! -e /etc/udev/rules.d/70-cuvee-udmabuf.rules ]]; then
    echo 'KERNEL=="udmabuf", GROUP="kvm", MODE="0660"' |
      sudo tee /etc/udev/rules.d/70-cuvee-udmabuf.rules >/dev/null
    ok "regra udev criada para /dev/udmabuf"
  fi
  sudo udevadm control --reload
  sudo udevadm trigger --subsystem-match=misc --action=change || true

  if [[ " $(gpu_vendors) " == *" nvidia "* ]] && (($(sysctl -n vm.max_map_count 2>/dev/null || echo 0) < MAX_MAP_COUNT)); then
    echo "vm.max_map_count = $MAX_MAP_COUNT" | sudo tee /etc/sysctl.d/70-cuvee.conf >/dev/null
    sudo sysctl -q -w vm.max_map_count="$MAX_MAP_COUNT"
    ok "vm.max_map_count = $MAX_MAP_COUNT (NVIDIA; /etc/sysctl.d/70-cuvee.conf)"
  fi

  if ! in_group "$USER" kvm; then
    sudo usermod -aG kvm "$USER"
    ok "você foi adicionado ao grupo kvm"
    changed=1
  fi

  echo
  if ((changed)); then
    echo "Pronto. Saia e entre de novo na sessão (ou reinicie) para valer o grupo kvm."
  else
    echo "Nada a mudar: o host já estava preparado."
  fi
  echo "Depois rode: cuvee doctor"
}

run_reims_ctl() {
  command -v reims-ctl >/dev/null 2>&1 || die "reims-ctl não encontrado: instale o pacote reims-vgpu-git"
  # O reims-ctl procura o QEMU em ~/.local/share/reims-ctl; o pacote instala em /usr/lib/cuvee.
  if [[ -z ${REIMS_CTL_QEMU:-} && -x $QEMU_BIN ]]; then
    export REIMS_CTL_QEMU="$QEMU_BIN"
  fi
  exec reims-ctl "$@"
}

usage() {
  cat <<EOF
Cuvée $CUVEE_VERSION: VMs de macOS no Arch Linux, sobre o reims-ctl.

Uso:
  cuvee                 abre o menu interativo
  cuvee doctor          verifica se o host está pronto
  cuvee setup-host      prepara o host (KVM, udmabuf, sysctl em NVIDIA; pede sudo)
  cuvee create mac --macos tahoe --start
                        cria e liga uma VM com o macOS 26
  cuvee help-reims      todos os comandos do reims-ctl

Qualquer outro comando vai direto para o reims-ctl.
Atualize pelo pacman ou pelo seu AUR helper, não por "cuvee update".
EOF
}

case "${1:-}" in
  doctor) cmd_doctor ;;
  setup-host) cmd_setup_host ;;
  -h | --help | help) usage ;;
  -V | --version | version) echo "cuvee $CUVEE_VERSION" ;;
  help-reims) shift; run_reims_ctl help "$@" ;;
  update)
    die "o Cuvée é atualizado pelo pacman: rode seu AUR helper (por exemplo, yay -Syu)"
    ;;
  *) run_reims_ctl "$@" ;;
esac
