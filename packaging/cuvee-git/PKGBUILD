# Maintainer: Yuri <yurisanp at github>

pkgname=cuvee-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="macOS virtual machines on Arch Linux, built on reims-vgpu's reims-ctl"
arch=(x86_64)
url="https://github.com/yurisanp/cuvee"
license=(GPL-3.0-or-later)
depends=(reims-vgpu-git gcc-libs glibc)
makedepends=(git cargo)
optdepends=('vulkan-tools: lets cuvee doctor test Vulkan')
provides=(cuvee)
conflicts=(cuvee)
install=cuvee.install
# Branch to build (override with _branch=... makepkg).
_branch="${_branch:-main}"
source=("cuvee::git+https://github.com/yurisanp/cuvee.git#branch=$_branch")
sha256sums=(SKIP)

pkgver() {
  cd cuvee
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd cuvee
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd cuvee
  export CARGO_TARGET_DIR=target
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/$pkgname"
  cargo build --frozen --release -p cuvee-cli
}

check() {
  cd cuvee
  cargo test --frozen -p cuvee-core -p cuvee-cli
}

package() {
  cd cuvee
  install -Dm755 target/release/cuvee "$pkgdir/usr/bin/cuvee"
  # cuvee install and cuvee update leave this install to pacman.
  install -d "$pkgdir/usr/lib/cuvee"
  echo pacman >"$pkgdir/usr/lib/cuvee/packaged"
  install -Dm644 host/70-cuvee-udmabuf.rules "$pkgdir/usr/lib/udev/rules.d/70-cuvee-udmabuf.rules"
  install -Dm644 host/cuvee.conf "$pkgdir/usr/lib/modules-load.d/cuvee.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
