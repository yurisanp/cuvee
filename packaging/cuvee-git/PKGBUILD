# Maintainer: Yuri <yurisanp at github>

pkgname=cuvee-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="macOS virtual machines on Arch Linux, built on reims-vgpu's reims-ctl"
arch=(any)
url="https://github.com/yurisanp/cuvee"
license=(GPL-3.0-or-later)
depends=(bash reims-vgpu-git)
makedepends=(git)
optdepends=('vulkan-tools: lets cuvee doctor test Vulkan')
provides=(cuvee)
conflicts=(cuvee)
install=cuvee.install
# Branch to build (override with _branch=... makepkg).
_branch="${_branch:-main}"
source=("cuvee::git+https://github.com/yurisanp/cuvee.git#branch=$_branch")
sha256sums=(SKIP)

pkgver() {
  cd cuvee
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd cuvee
  install -Dm755 bin/cuvee "$pkgdir/usr/bin/cuvee"
  sed -i "s/@VERSION@/$pkgver/" "$pkgdir/usr/bin/cuvee"
  install -Dm644 host/70-cuvee-udmabuf.rules "$pkgdir/usr/lib/udev/rules.d/70-cuvee-udmabuf.rules"
  install -Dm644 host/cuvee.conf "$pkgdir/usr/lib/modules-load.d/cuvee.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
